Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Color: 130; 130; 130
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.6
    - Class: rviz_default_plugins/RobotModel
      Name: R1
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: 静态地图
      Enabled: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.6
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: 全局代价地图
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.35
      Color Scheme: costmap
    - Class: rviz_default_plugins/PointCloud2
      Name: 雷达（base_link）
      Enabled: false
      Topic:
        Value: /r1/fusion/points_lidar
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 180; 180; 180
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: 深度（base_link）
      Enabled: false
      Topic:
        Value: /r1/fusion/points_depth
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 60; 200; 230
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: 融合点云
      Enabled: true
      Topic:
        Value: /r1/fusion/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 80; 240; 120
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: 全局路径
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 255; 170; 30
      Line Style: Lines
      Line Width: 0.03
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Name: Current View
      Pitch: 1.2
      Yaw: 0.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
